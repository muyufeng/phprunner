# ============================================================
# phprunner 版本单一事实源（①）
# 文档：docs/project-structure.md §1（build/versions.env）
#       docs/static-php-runtime-discussion.md §7.1（成对发布）
#
# 用法：根 Makefile include 本文件（./dev 与 compose 自举脚本已删，2026-08-16）。
#       任何修改 ⇒ 同批重跑 make binaries（双产物成对不变量）。
# 格式：KEY=value（可被 shell source / make include）
# ============================================================

# --- PHP 版本：双二进制必须同 x.y.z（成对发布不变量）---
PHP_VERSION=8.5.9

# --- ZTS 侧：frankenphp 版本（官方 static-builder-gnu，§3 #11）---
# 2026-08-07 v1.12.7（bugfix，含两处关键修复）：
#   - classic mode：frankenphp_finish_request() 后输出被静默丢弃（#2569）
#     ——classic 是本项目默认请求模型（§2）
#   - opcache：移除 invalidation 重启钩子，防递归重启级联（#2564）
#     ——opcache 为 §4 最高风险项、§9 #3 冒烟重点
FRANKENPHP_VERSION=1.12.7

# --- NTS 侧：spc 工具本体 ---
# 分发：https://dl.static-php.dev/static-php-cli/spc-bin/nightly/spc-linux-x86_64
# ⚠️ TODO(M1)：nightly 无稳定版本号，首编时确定锚点方案
#   （下载后 sha256 记录进本文件注释，Makefile 校验）并回填此处
SPC_VERSION=nightly-pending

# --- 构建环境 pin（版本 + 环境双层 pin，可复现性闭环）---
# 官方 static-builder-gnu 底座镜像
# 节奏（2026-08-16 校准）：M1 试错期用 tag（拿最新修复，排除旧基座干扰）；
#   M1 收口产出定版前回填 digest（tag@sha256:… 并用写法，可读 + 不可变），
#   此后"同 versions.env = 同产物"才闭环。更新 digest = 手动改本文件 + 成对重建。
#   §9 #12 源码结论：builder 内 spc 无版本 pin 接口（source=main+pull / binary=nightly），
#   digest 是最大锚点（工具链 + build-static.sh + 源码基座），spc 残余漂移靠
#   构建报告记录实际版本追溯
# 已获取快照（2026-08-16 手动 pull，1.12.7 时代，go.sh 含 PHP_CONFIG 变更已核验）：
#   sha256:0e00a5f130721813f2fc7334c2942187b8488810c96bc91d3956deff6d9fbd13
STATIC_BUILDER_IMAGE=dunglas/frankenphp:static-builder-gnu

# spc 构建环境底座（build/php-cli.Dockerfile 的 spc-env target 用）
SPC_ENV_BASE_IMAGE=debian:trixie-slim

# --- 装配底座：三镜像 FROM（M3，images/*.Dockerfile）---
# 同为一身两职：builder-spc 构建环境底座（SPC_ENV_BASE_IMAGE）也用它。
# 节奏同上：试错期用 tag，定版（M3 收口）回填 digest。
# 已获取快照（2026-08-16 手动 pull）：
#   sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258
BASE_IMAGE=debian:trixie-slim

# --- apt 国内源（§0 #6 容器内 apt 一律国内源）---
# 空值 = 回退官方源（--build-arg APT_MIRROR=）；smoke/base.Dockerfile 与
# images/*.Dockerfile 同款（DEB822 一次 sed，中科大方案）
APT_MIRROR=mirrors.ustc.edu.cn

# --- s6-overlay：runtime 形态进程管理器（§3 #7）---
# 分发：https://github.com/just-containers/s6-overlay/releases
# 单 arch 起步：noarch + x86_64 两 tarball 俱需（ADD 自动解包）
S6_OVERLAY_VERSION=v3.2.1.0

# --- 迭代号：镜像 tag 尾缀，规约 phprunner/<形态>:<PHP>-r<N> ---
RELEASE_ITER=1

# --- 目标架构（单 arch 起步，§6 取舍；aarch64 延后）---
# 注意：需与构建宿主 uname -m 一致（本方案不做交叉编译）
TARGET_ARCH=x86_64
