# ============================================================
# phprunner 版本单一事实源（①）
# 文档：docs/project-structure.md §1（build/versions.env）
#       docs/static-php-runtime-discussion.md §7.1（成对发布）
#
# 用法：根 Makefile include 本文件（./dev 与 compose 自举脚本已删，2026-08-16）。
#       任何修改 ⇒ 同批重跑 make binaries（双产物成对不变量）。
# 格式：KEY=value（可被 shell source / make include）
# ============================================================

# --- PHP 版本：双二进制必须同 x.y.z（成对发布不变量）---
PHP_VERSION=8.5.10

# --- ZTS 侧：frankenphp 版本（官方 static-builder-gnu，§3 #11）---
FRANKENPHP_VERSION=1.12.7

# --- NTS 侧：spc 工具本体 ---
# 分发：https://dl.static-php.dev/static-php-cli/spc-bin/nightly/spc-linux-x86_64
# ⚠️ TODO(M1)：nightly 无稳定版本号，首编时确定锚点方案
#   （下载后 sha256 记录进本文件注释，Makefile 校验）并回填此处
SPC_VERSION=nightly-pending

# --- 构建环境 pin（版本 + 环境双层 pin，可复现性闭环）---
# 官方 static-builder-gnu 底座镜像
#   核对方法：docker run --rm <tag> ls /go/src/app/build-static.sh 须存在。
#   docker pull dunglas/frankenphp:static-builder-gnu
#   docker pull dunglas/frankenphp:static-builder-gnu-1.12.7
STATIC_BUILDER_IMAGE=dunglas/frankenphp:static-builder-gnu-1.12.7@sha256:b1d87d852865869b353931494211cfece263445a5cc7bdf6f4da69abc816c249

# spc 构建环境底座（build/php-cli.Dockerfile 的 spc-env target 用），pin 节奏同上
SPC_ENV_BASE_IMAGE=debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

# --- 装配底座：三镜像 FROM（M3，src/variations/<形态>/Dockerfile）---
# 一身两职：builder-spc 构建环境底座（SPC_ENV_BASE_IMAGE）也用它；
# 2026-08-21 起 pin 到 digest，与 SPC_ENV_BASE_IMAGE 同一快照
BASE_IMAGE=debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

# --- apt 国内源（§0 #6 容器内 apt 一律国内源）---
# 空值 = 回退官方源（--build-arg APT_MIRROR=）；smoke/base.Dockerfile 与
# images/*.Dockerfile 同款（DEB822 一次 sed，中科大方案）
APT_MIRROR=mirrors.ustc.edu.cn

# --- s6-overlay：runtime 形态进程管理器（§3 #7）---
# 分发：https://github.com/just-containers/s6-overlay/releases
# 单 arch 起步：noarch + x86_64 两 tarball 俱需（ADD 自动解包）
S6_OVERLAY_VERSION=v3.2.3.2

# --- 镜像配方迭代号（不是二进制迭代）---
# · tag：phprunner/<形态：cli/frankenphp/unit>:<PHP_VERSION 完整三段：8.5.9>-r<RELEASE_ITER>
# · 三形态共用同一 N：unit 的 FROM ...frankenphp:${PHP_VERSION}-r${RELEASE_ITER} 依赖同号
# · 落点：镜像 tag + 镜像内 /etc/phprunner-version
# · bump：改 src/** → N+1 重建三镜像；改 build/** → 不动（PHP 段自变）
# · Dockerfile 侧同名 ARG 是死默认值，不在此维护
RELEASE_ITER=1

# --- 目标架构（单 arch 起步，§6 取舍；aarch64 延后）---
# 注意：需与构建宿主 uname -m 一致（本方案不做交叉编译）
TARGET_ARCH=x86_64
